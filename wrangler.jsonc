{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wyc-database-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    { "binding": "PROFILE_PHOTOS", "bucket_name": "profile-pictures-dev" },
    { "binding": "WAIVERS", "bucket_name": "wyc-waivers-dev" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wyc-database-dev",
      "database_id": "3962fed4-2455-442a-96c4-c5a104408c05",
      "migrations_dir": "migrations/d1",
    },
  ],
}
